{
    "name": "wingdex",
    "private": true,
    "version": "1.25.1",
    "description": "Photo-first bird identification and WingDex tracker",
    "repository": {
        "type": "git",
        "url": "https://github.com/jlian/wingdex.git"
    },
    "author": "John Lian",
    "license": "MIT",
    "keywords": [
        "birding",
        "bird-identification",
        "life-list",
        "ebird"
    ],
    "type": "module",
    "engines": {
        "node": ">=24.0.0"
    },
    "scripts": {
        "dev": "bash scripts/dev.sh",
        "start": "bash scripts/dev-full.sh",
        "stop": "bash scripts/kill-dev.sh",
        "build": "tsc -b && vite build && wrangler pages functions build --outdir=./dist/worker/ && node scripts/check-asset-cap.mjs",
        "deploy": "npm run build && wrangler deploy",
        "lint": "eslint .",
        "typecheck": "tsc -b",
        "test": "npm run test:web && npm run test:functions",
        "test:web": "vitest run",
        "test:functions": "vitest run --config vitest.functions.config.ts",
        "test:e2e": "npx playwright test --grep-invert @live",
        "test:e2e:live": "npx playwright test --grep @live",
        "check": "npm run lint && npm run typecheck && npm test",
        "check:all": "npm run check && npm run build && npx playwright install --with-deps chromium && npm run db:migrate && npm run test:e2e",
        "db:migrate": "printf 'y\n' | wrangler d1 migrations apply wingdex-db --local --persist-to \"$HOME/.cache/wingdex/wrangler-state\"",
        "fixtures": "node scripts/capture-llm-fixtures.mjs",
        "taxonomy": "bash scripts/taxonomy.sh"
    },
    "dependencies": {
        "@better-auth/core": "1.7.1",
        "@better-auth/passkey": "1.7.1",
        "@mapbox/vector-tile": "^3.0.0",
        "@phosphor-icons/react": "^2.1.7",
        "@radix-ui/colors": "^3.0.0",
        "@radix-ui/react-accordion": "^1.2.3",
        "@radix-ui/react-alert-dialog": "^1.1.6",
        "@radix-ui/react-aspect-ratio": "^1.1.2",
        "@radix-ui/react-avatar": "^1.1.3",
        "@radix-ui/react-checkbox": "^1.1.4",
        "@radix-ui/react-collapsible": "^1.1.3",
        "@radix-ui/react-context-menu": "^2.2.6",
        "@radix-ui/react-dialog": "^1.1.6",
        "@radix-ui/react-dropdown-menu": "^2.1.6",
        "@radix-ui/react-hover-card": "^1.1.6",
        "@radix-ui/react-label": "^2.1.2",
        "@radix-ui/react-menubar": "^1.1.6",
        "@radix-ui/react-navigation-menu": "^1.2.5",
        "@radix-ui/react-popover": "^1.1.6",
        "@radix-ui/react-progress": "^1.1.2",
        "@radix-ui/react-radio-group": "^1.2.3",
        "@radix-ui/react-scroll-area": "^1.2.9",
        "@radix-ui/react-select": "^2.1.6",
        "@radix-ui/react-separator": "^1.1.2",
        "@radix-ui/react-slider": "^1.3.6",
        "@radix-ui/react-slot": "^1.1.2",
        "@radix-ui/react-switch": "^1.1.3",
        "@radix-ui/react-tabs": "^1.1.3",
        "@radix-ui/react-toggle": "^1.1.2",
        "@radix-ui/react-toggle-group": "^1.1.2",
        "@radix-ui/react-tooltip": "^1.1.8",
        "@tailwindcss/container-queries": "^0.1.1",
        "@tailwindcss/vite": "^4.2.1",
        "better-auth": "1.7.1",
        "better-call": "1.4.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "kysely-d1": "^0.4.0",
        "lucide-react": "^0.568.0",
        "next-themes": "^0.4.6",
        "onnxruntime-web": "^1.27.0",
        "papaparse": "^5.5.3",
        "pbf": "^5.1.2",
        "pmtiles": "^4.5.0",
        "react": "^19.2.4",
        "react-dom": "^19.2.4",
        "react-error-boundary": "^6.0.0",
        "sonner": "^2.0.1",
        "tailwind-merge": "^3.0.2",
        "tw-animate-css": "^1.2.4",
        "tz-lookup": "^6.1.25",
        "vaul": "^1.1.2",
        "zod": "^4.3.6"
    },
    "overrides": {
        "@tailwindcss/vite": {
            "vite": "$vite"
        }
    },
    "devDependencies": {
        "@aws-sdk/client-s3": "^3.1013.0",
        "@cloudflare/workers-types": "^5.20260804.1",
        "@commitlint/cli": "^21.2.1",
        "@commitlint/config-conventional": "^21.2.0",
        "@eslint/js": "^9.21.0",
        "@playwright/test": "^1.58.2",
        "@semantic-release/changelog": "^6.0.3",
        "@semantic-release/exec": "^7.1.0",
        "@semantic-release/git": "^10.0.1",
        "@testing-library/dom": "^10.4.1",
        "@testing-library/jest-dom": "^6.9.1",
        "@testing-library/react": "^16.3.2",
        "@testing-library/user-event": "^14.6.1",
        "@types/node": "^22.19.11",
        "@types/react": "^19.2.14",
        "@types/react-dom": "^19.0.4",
        "@types/tz-lookup": "^6.1.2",
        "@vitejs/plugin-react": "^6.0.1",
        "better-sqlite3": "^12.8.0",
        "eslint": "^9.28.0",
        "eslint-plugin-react-hooks": "^7.0.1",
        "eslint-plugin-react-refresh": "^0.5.0",
        "globals": "^16.0.0",
        "jsdom": "^28.1.0",
        "semantic-release": "^25.0.3",
        "semantic-release-monorepo": "^8.0.2",
        "sharp": "^0.34.5",
        "tailwindcss": "^4.1.18",
        "typescript": "~5.7.2",
        "typescript-eslint": "^8.38.0",
        "vite": "^8.0.0",
        "vitest": "^4.1.0",
        "wrangler": "^4.119.0"
    }
}
