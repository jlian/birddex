ml/parity/*.json
# ...except the small committed subset. The full set is 90 MB of NABirds-derived
# fixtures that lives on the training box, but CLIPPreprocessParityTests skipped on
# every CI run without it, so the preprocessing parity it asserts was never checked.
# Two photos are enough: every test iterates meta.photos. Regenerate the full set
# with ml/distill/jobs/dump_preproc_ref.py then ml/parity/jobs/dump_js.ts.
!ml/parity/meta.json
!ml/parity/src_000.u8.bin
!ml/parity/ref_000.f32.bin
!ml/parity/js_000.f32.bin
!ml/parity/src_001.u8.bin
!ml/parity/ref_001.f32.bin
!ml/parity/js_001.f32.bin

# Core ML scratch: the venv, the converted packages and generated audit output.
# The scripts themselves are tracked, the artifacts are regenerable.
ml/coreml/.venv/
ml/coreml/*.mlpackage/
ml/coreml/*.log
ml/coreml/*.json
ml/coreml/__pycache__/

# Stale: BirdIDParityTests now inflates public/priors/occurrence.*.bin.gz directly
# rather than requiring a hand-generated copy here, so nothing writes this path any
# more. Kept so an existing 23 MiB local copy does not get committed by accident.
ios/WingDexTests/Fixtures/occurrence.bin

# Derived from public/ by ios/scripts/sync-birdid-assets.sh. The .mlpackage in
# WingDex/ML is NOT derived and IS committed: it needs a torch/coremltools
# environment and a checkpoint that only exists on Hugging Face.
ios/WingDex/Resources/BirdID/

public/parity/
public/node_modules

# Parity fixtures are GENERATED artifacts, not source. Every harness takes the
# fixture directory as argv, so no path is hardcoded and nothing breaks by
# ignoring them.
#
# This also fixes an inconsistency: the two sets behind the shipping numbers,
# fixtures-tiny39-a060 and fixtures-calib11k at 11,070 files each, were ALREADY
# untracked, while four obsolete 27-file sets were committed. The repo was
# tracking the fixtures that did not matter and ignoring the ones that did.
ml/fixtures*/

# The ml/ tree is research-only and lives on tomahawk. It is TRACKED on the
# research branch and entirely UNTRACKED on the app branches, where it can
# reach 148 GB across 455k files. These rules live at the ROOT, not in
# ml/.gitignore, because a nested ignore file is itself part of the research
# branch: check out an app branch and it disappears, leaving the whole tree
# visible to git status and to the vite dev server file watcher.
ml/inat-metadata/
ml/groundtruth/
ml/imagenette/
ml/embeddings/
ml/heldout-orig/
ml/heldout-orig-corpus/
ml/val_ids_seed0.json
ml/val_split_seed0.json
ml/distill/.venv/
ml/distill/runs/
ml/distill/calib_corpus/
ml/distill/embeddings/
ml/**/__pycache__/
# Model artifacts are BUILD OUTPUTS, but the three below are TRACKED and SHIP.
# The app fetches them at runtime from /models/, so they must exist in the repo
# and in any deploy built from a clean checkout. They are regenerated by
# ml/distill/emit_int8_classifier.py and jobs/phase4_quant.sh, and a rebuild is
# expected to be byte-identical from tracked sources.
#
# The directory stays ignored so intermediate exports (fp32 ONNX, per-alpha
# variants, scratch quantization attempts) do not get committed by accident.
# The three re-includes below mean a REGENERATED shipped artifact shows up in
# `git status` normally. Without them the rule silently swallowed the real
# change and every update needed `git add -f`, which is how the ONNX once moved
# without MODEL_VERSION being bumped with it.
public/models/*
!public/models/text_classifier_int8.bin
!public/models/wingclip_visual_int8.onnx
!public/models/wingclip_visual_int8.data
public/parity/
public/node_modules

# Parity fixtures are GENERATED artifacts, not source. Every harness takes the
# fixture directory as argv, so no path is hardcoded and nothing breaks by
# ignoring them.
#
# This also fixes an inconsistency: the two sets behind the shipping numbers,
# fixtures-tiny39-a060 and fixtures-calib11k at 11,070 files each, were ALREADY
# untracked, while four obsolete 27-file sets were committed. The repo was
# tracking the fixtures that did not matter and ignoring the ones that did.
ml/fixtures*/

# Python bytecode from scripts/
scripts/__pycache__/
