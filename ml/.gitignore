# ml/ scratch + large-artifact guard (defensive; see ml/distill/.gitignore for the
# per-stage rules). These cover spike/scratch leftovers that map to ml/ top level
# when the tomahawk working dir is consolidated into the repo.

# Python envs / caches
.venv/
__pycache__/
*.pyc

# ONNX / Core ML / weight exports (regenerable, large)
onnx-export/
*.onnx
*.mlpackage/
*.mlmodel
*.ort

# Archives + big scratch blobs
*.tgz
*.tar.gz
*.zip

# Cloned upstream repos used as scratch (e.g. Apple ml-mobileclip)
ml-mobileclip/

# Logs
*.log

# Model checkpoints / caches that might land at ml/ level
*.pt
*.npz
*.npy
*.duckdb

# Held-out originals re-downloaded from iNat at full size for the preprocessing
# study. ~3.5 GB, regenerable: distill/fetch_large.py + val_ids_seed0.json.
heldout-orig/
heldout-orig-corpus/
val_ids_seed0.json
val_split_seed0.json

# HF upload staging dirs: copies of weights already on the hub
distill/hf_stage*/

# hard negatives: 20k non-bird wildlife photos, regenerable from build_hard_negatives.py
hard-negatives/
